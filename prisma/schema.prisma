// DailyRapFrance — Schéma de données V1 "Le Graphe"
// Cible : Supabase Postgres (gratuit)
// Référence : 00_MASTER_PROMPT.md (§6 critères succès), 02_PRODUCT.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENTITÉS NOYAU
// ─────────────────────────────────────────────

model Artist {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  aliases       String[] // ex: ["Jul", "JuL"]
  bio           String?
  city          String?
  department    String?  // point d'extension carte V2
  photoUrl      String?
  labelId       String?
  label         Label?   @relation(fields: [labelId], references: [id])
  status        ArtistStatus @default(SKELETON) // riche / standard / squelette (§3.2 PRODUCT)

  spotifyId     String?  @unique
  deezerId      String?  @unique
  youtubeId     String?  @unique
  musicbrainzId String?  @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  releases      ReleaseArtist[]
  credits       Credit[]
  socialStats   SocialStat[]
  hypeScores    HypeScore[]
  certifications Certification[]
  chartEntries  ChartEntry[]

  @@index([status])
  @@index([city])
}

enum ArtistStatus {
  SKELETON  // créé par pipeline, non enrichi
  STANDARD  // fiche complète, données quotidiennes
  RICH      // top 500, données horaires
}

model Label {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  artists   Artist[]
  releases  Release[]
}

model Release {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  type          ReleaseType
  releaseDate   DateTime?
  announcedDate DateTime?    // pour les pages "à venir" (§4 PRODUCT)
  coverUrl      String?
  labelId       String?
  label         Label?       @relation(fields: [labelId], references: [id])
  status        ReleaseStatus @default(ANNOUNCED)

  spotifyId     String?      @unique
  deezerId      String?      @unique
  fans          BigInt?      // popularité de l'album sur Deezer (endpoint /album/{id})
  explicit      Boolean?     // explicit_lyrics Deezer

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  artists       ReleaseArtist[]
  tracks        Track[]
  certifications Certification[]
  chartEntries  ChartEntry[]

  @@index([status])
  @@index([releaseDate])
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
  MIXTAPE
}

enum ReleaseStatus {
  ANNOUNCED  // countdown pré-sortie
  RELEASED
}

// Table de jonction Artist <-> Release (gère les collaborations d'album)
model ReleaseArtist {
  id        String  @id @default(cuid())
  artistId  String
  releaseId String
  role      ArtistRoleOnRelease @default(MAIN)
  artist    Artist  @relation(fields: [artistId], references: [id])
  release   Release @relation(fields: [releaseId], references: [id])

  @@unique([artistId, releaseId, role])
}

enum ArtistRoleOnRelease {
  MAIN
  FEATURED
}

model Track {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  releaseId   String
  release     Release  @relation(fields: [releaseId], references: [id])
  trackNumber Int?
  durationSec Int?
  streamsTotal BigInt?
  spotifyId   String?  @unique
  deezerId    String?  @unique
  isrc        String?  @unique // code international, fiable pour dédupliquer entre sources
  deezerRank  Int?     // popularité Deezer du titre (0 à ~1 000 000), rafraîchi à chaque run
  explicit    Boolean?
  bpm         Float?
  gain        Float?   // loudness (dB), pas une "stat" au sens strict mais fournie par Deezer

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credits     Credit[]

  @@index([releaseId])
}

// Crédits : qui a fait quoi sur un titre (feat, prod, auteur...) — le cœur du graphe relationnel
model Credit {
  id       String     @id @default(cuid())
  trackId  String
  artistId String
  role     CreditRole
  track    Track      @relation(fields: [trackId], references: [id])
  artist   Artist     @relation(fields: [artistId], references: [id])

  @@unique([trackId, artistId, role])
  @@index([artistId, role])
}

enum CreditRole {
  PERFORMER
  FEATURED
  PRODUCER
  WRITER
  SAMPLE_SOURCE
}

// ─────────────────────────────────────────────
// SIGNAUX TEMPORELS (append-only, alimentés par les pipelines)
// ─────────────────────────────────────────────

model SocialStat {
  id            String   @id @default(cuid())
  artistId      String
  artist        Artist   @relation(fields: [artistId], references: [id])
  source        StatSource
  monthlyListeners BigInt?
  followers     BigInt?
  capturedAt    DateTime @default(now())

  @@index([artistId, source, capturedAt])
}

enum StatSource {
  SPOTIFY
  DEEZER
  YOUTUBE
}

model Certification {
  id         String   @id @default(cuid())
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id])
  releaseId  String?
  release    Release? @relation(fields: [releaseId], references: [id])
  level      CertLevel
  multiplier Int      @default(1) // 1 = Or/Platine/Diamant simple, 2 = Double Platine, 8 = "8 fois Diamant"...
  certifiedAt DateTime
  source     String   @default("SNEP") // "SNEP" ou "UPFI" — voir pipelines/import-certifications.js
  sourceUrl  String?  // lien vers la fiche officielle, pour la traçabilité (P6 : on ne republie pas sans source)

  @@unique([artistId, releaseId, level, multiplier, certifiedAt], name: "certification_natural_key")
  @@index([artistId])
  @@index([releaseId])
}

enum CertLevel {
  OR
  PLATINE
  DIAMANT
}

model ChartEntry {
  id         String   @id @default(cuid())
  chartType  ChartType
  periodKey  String   // ex: "2026-S30" pour hebdo, "2026-07-25" pour quotidien
  position   Int
  artistId   String?
  artist     Artist?  @relation(fields: [artistId], references: [id])
  releaseId  String?
  release    Release? @relation(fields: [releaseId], references: [id])

  @@unique([chartType, periodKey, artistId], name: "chart_entry_natural_key")
  @@index([chartType, periodKey])
}

enum ChartType {
  DRF_STREAMING // alimenté par pipelines/ingest-chart.js (playlist Deezer "Rapstars", gratuite,
                // choisie plutôt que /chart/116 car non dépendante de la géolocalisation IP)
  SNEP_RAP      // non alimenté : le Top SNEP officiel est explicitement "tous droits réservés
                // à la SCPP" sur snepmusique.com — pas de PDF/CSV d'export non plus (contrairement
                // aux certifications). Voir README pour le détail.
  HYPE          // futur : calculé en interne, voir HypeScore
}

model HypeScore {
  id         String   @id @default(cuid())
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id])
  score      Int      // 0-100
  explanation String? // généré par IA, jamais de donnée non affichée sur la fiche (CA §7 PRODUCT)
  computedAt DateTime @default(now())

  @@index([artistId, computedAt])
}

// Actus agrégées depuis des flux RSS publics (P6 : sources 100% légales).
// Chaque entrée renvoie vers l'article original — on ne republie pas le contenu.
model NewsItem {
  id          String   @id @default(cuid())
  title       String
  link        String   @unique
  source      String   // nom du média source, ex: "Booska-P"
  publishedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([publishedAt])
}
