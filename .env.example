# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs.
#
# Depuis Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre_clé_anon_publique"

# Rien d'autre n'est nécessaire — l'API Deezer utilisée par le blind test est publique et
# sans clé.

# Optionnel — Google Analytics 4. Laisser vide/absent = pas de tracking chargé du tout.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Optionnel — mode « Devine le clip » (clips YouTube). Clé YouTube Data API v3 (Google Cloud
# Console → APIs & Services → Credentials → API key, restreinte à YouTube Data API v3).
# Sans cette clé, le mode clip est masqué. Lancer aussi supabase/migration-clip-videos.sql.
YOUTUBE_API_KEY=""
